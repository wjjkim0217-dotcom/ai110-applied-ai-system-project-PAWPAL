# Copy this file to .env and fill in ONE key. .env is git-ignored: never commit it.

# Option 1 (free): Google Gemini. Get a key at https://aistudio.google.com/apikey
PAWPAL_PROVIDER=gemini
GEMINI_API_KEY=paste-your-gemini-key-here

# Option 2 (paid): Claude. Set PAWPAL_PROVIDER=anthropic and fill in:
# ANTHROPIC_API_KEY=

# Optional overrides
# PAWPAL_MODEL=gemini-3.5-flash-lite      # or claude-opus-5-5 with the anthropic provider
# PAWPAL_EFFORT=medium               # Claude only
